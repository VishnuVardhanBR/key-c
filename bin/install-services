#!/usr/bin/env python3
"""Register Paseo, the gateway, tunnel, and identity supervisor as user agents."""
from pathlib import Path
import os
import plistlib
import shutil
import subprocess
import time

runtime = Path.home() / 'Library/Application Support/key-c'
app = runtime / 'app'
node = shutil.which('node')
python = shutil.which('python3')
if not node or not python:
    raise SystemExit('Node.js and Python 3 are required.')
jobs = {
    'paseo': [node, str(app / 'bin/paseo-server.mjs')],
    'origin': [node, str(app / 'bin/origin-server.mjs')],
    'tunnel': [str(app / 'bin/tunnel')],
    'identity': [python, str(app / 'bin/identity-service')],
    'watchdog': [python, str(app / 'bin/service_watchdog.py')],
}
(Path.home() / 'Library/LaunchAgents').mkdir(parents=True, exist_ok=True)
target = f'gui/{os.getuid()}'
for name, arguments in jobs.items():
    label = f'com.keyc.remote-{name}'
    config = {'Label': label, 'ProgramArguments': arguments, 'RunAtLoad': True,
              'KeepAlive': True, 'ThrottleInterval': 10, 'Umask': 63,
              'WorkingDirectory': str(runtime),
              'StandardOutPath': str(runtime / 'logs' / f'{name}.log'),
              'StandardErrorPath': str(runtime / 'logs' / f'{name}.log'),
              'EnvironmentVariables': {'HOME': str(Path.home()),
                  'PATH': str(Path(node).parent) + ':' + os.environ.get('PATH', os.defpath)}}
    if name == 'watchdog':
        config.pop('KeepAlive')
        config.update(StartInterval=60, ProcessType='Background')
    plist = Path.home() / 'Library/LaunchAgents' / f'{label}.plist'
    plist.write_bytes(plistlib.dumps(config)); plist.chmod(0o600)
    if subprocess.run(['launchctl', 'print', f'{target}/{label}'], capture_output=True).returncode == 0:
        continue  # Writing next-login configuration must not disconnect an active user.
    if (runtime / 'run/services-paused').exists():
        continue
    for attempt in range(20):
        result = subprocess.run(['launchctl', 'bootstrap', target, str(plist)], capture_output=True)
        if result.returncode == 0:
            break
        time.sleep(0.5)
    else:
        raise SystemExit(result.stderr.decode())
print('User services installed without restarting loaded jobs. They start after macOS login unless paused.')
