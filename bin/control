#!/usr/bin/env python3
"""Start, stop, or inspect this Mac's key-c services without deleting data."""
from pathlib import Path
import argparse
import os
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['status', 'start', 'stop'])
action = parser.parse_args().action
target = f'gui/{os.getuid()}'
runtime = Path.home() / 'Library/Application Support/key-c'
names = ['identity', 'terminal', 'paseo', 'origin', 'tunnel']
for name in reversed(names) if action == 'stop' else names:
    label = f'com.keyc.remote-{name}'
    service = f'{target}/{label}'
    result = subprocess.run(['launchctl', 'print', service], capture_output=True, text=True)
    if action == 'status':
        state = next((line.strip() for line in result.stdout.splitlines()
                      if line.strip().startswith('state =')), 'not loaded')
        print(f'{name}: {state}')
    elif action == 'stop':
        if result.returncode == 0:
            subprocess.run(['launchctl', 'bootout', service], check=True)
            for _ in range(50):
                if subprocess.run(['launchctl', 'print', service], capture_output=True).returncode:
                    break
                time.sleep(0.2)
        print(f'{name}: stopped')
    else:
        if result.returncode:
            plist = Path.home() / 'Library/LaunchAgents' / f'{label}.plist'
            subprocess.run(['launchctl', 'bootstrap', target, str(plist)], check=True)
        print(f'{name}: started')
if action == 'status':
    subprocess.run([str(Path(__file__).resolve().parent / 'compose'), 'ps',
                    '--format', '{{.Service}}: {{.State}} ({{.Health}})'], check=False)
    subprocess.run(['tmux', '-S', str(runtime / 'run/tmux.sock'),
                    'list-sessions'], check=False)
elif action == 'stop':
    print('key-c and the shared Paseo daemon stopped. tmux shells and stored data remain on this Mac.')
