#!/usr/bin/env python3
"""Keep the dedicated identity containers available after macOS login."""
from pathlib import Path
import subprocess
import time
import json

compose = str(Path(__file__).resolve().parent / 'compose')
docker = ['docker', '--context', 'colima-key-c']
while True:
    try:
        engine = subprocess.run(docker + ['info'], capture_output=True, timeout=15)
        if engine.returncode:
            subprocess.run(['colima', 'start', 'key-c',
                            '--activate=false'], check=True, timeout=180)
        result = subprocess.run([compose, 'ps', '--all', '--format', 'json'],
                                capture_output=True, text=True, check=True, timeout=20)
        services = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
        if len(services) < 3 or any(s.get('State') != 'running' for s in services):
            subprocess.run([compose, 'up', '-d'], check=True, timeout=120)
        else:
            unhealthy = [s['Service'] for s in services if s.get('Health') == 'unhealthy']
            if unhealthy:
                subprocess.run([compose, 'restart', *unhealthy], check=True, timeout=120)
    except (subprocess.SubprocessError, OSError, ValueError) as error:
        print(f'Identity service retry: {type(error).__name__}', flush=True)
    time.sleep(60)
