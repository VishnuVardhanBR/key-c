#!/usr/bin/env python3
"""Create bootstrap credentials outside the checkout; never overwrite existing ones."""
from pathlib import Path
import os
import secrets
from deployment import load_deployment

config = load_deployment()
os.umask(0o077)
folder = Path.home() / 'Library/Application Support/key-c/secrets'
folder.mkdir(mode=0o700, parents=True, exist_ok=True)
folder.chmod(0o700)
values = {name: secrets.token_urlsafe(48) for name in (
    'PG_PASS', 'AUTHENTIK_SECRET_KEY', 'AUTHENTIK_BOOTSTRAP_PASSWORD', 'AUTHENTIK_BOOTSTRAP_TOKEN')}
values['AUTHENTIK_BOOTSTRAP_EMAIL'] = config['owner_email']
path = folder / 'authentik.env'
with path.open('x') as output:
    output.write(''.join(f'{key}={value}\n' for key, value in values.items()))
path.chmod(0o600)
print('Created private authentik.env. Use it locally for bootstrap; do not commit or share it.')
